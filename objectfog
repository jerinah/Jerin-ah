        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "class SwinFocus(nn.Module):\n",
        "    \"\"\"\n",
        "    Lightweight SwinFocus-style attention block\n",
        "    \"\"\"\n",
        "    def __init__(self, channels):\n",
        "        super().__init__()\n",
        "        self.conv1 = nn.Conv2d(channels, channels, 1)\n",
        "        self.conv2 = nn.Conv2d(channels, channels, 3, padding=1, groups=channels)\n",
        "        self.conv3 = nn.Conv2d(channels, channels, 1)\n",
        "        self.act = nn.SiLU()\n",
        "\n",
        "    def forward(self, x):\n",
        "        identity = x\n",
        "        x = self.conv1(x)\n",
        "        x = self.conv2(x)\n",
        "        x = self.act(x)\n",
        "        x = self.conv3(x)\n",
        "        return x + identity\n",
        "EOF\n"
